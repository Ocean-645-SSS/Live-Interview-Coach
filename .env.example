# RAG 服务端口
LIVERAG_RAG_PORT=9819

# LightRAG 使用的 LLM
LIVERAG_RAG_LLM_MODEL=
LIVERAG_RAG_LLM_BASE_URL=
LIVERAG_RAG_LLM_API_KEY=

# LightRAG 使用的 Embedding 模型
LIVERAG_RAG_EMBEDDING_MODEL=
LIVERAG_RAG_EMBEDDING_BASE_URL=
LIVERAG_RAG_EMBEDDING_API_KEY=
LIGHTRAG_TIMEOUT_MS=120000

# LiveKit 本地服务和两个独立语音 Worker
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=liverag-local
LIVEKIT_API_SECRET=liverag-local-development-secret-0001
AGENT_NAME=my-agent
INTERVIEW_AGENT_NAME=interview-agent

# Interview Worker 使用该模型评价每轮回答
VOICE_LLM_MODEL=qwen-flash
VOICE_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VOICE_LLM_API_KEY=

# ---- Redis + Background Worker ----
# Redis 连接（本地开发默认值无需修改）
INTERVIEW_REDIS_URL=redis://127.0.0.1:6379/0
# Redis队列阻塞等待时间
INTERVIEW_REDIS_QUEUE_TIMEOUT=5
# Redis 分布式锁过期时间
INTERVIEW_REDIS_LOCK_TTL=300
# Worker 轮询间隔
INTERVIEW_WORKER_POLL_TIMEOUT=5
# Worker 任务超时（秒）
INTERVIEW_WORKER_TASK_TIMEOUT=300
# Worker 最大重试次数
INTERVIEW_WORKER_MAX_RETRIES=3
# Worker 并发任务数
INTERVIEW_WORKER_CONCURRENCY=4

# ---------------- Interview Intelligence 配置 --------------------
#是否启用company_intelligence服务
INTERVIEW_INTELLIGENCE_ENABLED=False
#服务来源：牛客网
INTERVIEW_INTELLIGENCE_PROVIDER="community_nowcoder_spider"
#最多结果数量
INTERVIEW_INTELLIGENCE_MAX_RESULTS=10
#牛客爬取超时时间
INTERVIEW_INTELLIGENCE_PROVIDER_TIMEOUT=30.0
#缓存新鲜时间
INTERVIEW_INTELLIGENCE_CACHE_FRESH=3600
#缓存过期时间
INTERVIEW_INTELLIGENCE_CACHE_STALE=86400

